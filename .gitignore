# Secrets — never commit
*.p8
*.pem
*.key
rsa_key*
.env
profiles.yml

# Large raw data (73 MB each) — keep out of Git
off_india_raw.csv
off_india_raw.tsv
fetch_csv.log.txt
data/raw/

# Python
.venv/
__pycache__/

# dbt
target/
dbt_packages/
logs/

# Exports (a .pbix file contains a copy of the data)
*.pdf
*.pbix

# dbt
.user.yml

# Local-only files (ODBC installer, raw extracts)
data/

# CI profile: no secrets, only env_var() references
!.github/dbt/profiles.yml

# Report PDF for the README (built from screenshots, no data)
!docs/*.pdf
